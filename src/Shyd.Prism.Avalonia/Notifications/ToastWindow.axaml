<Window
    x:Class="Shyd.Prism.Notifications.ToastWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="notifications:ToastWindowBase"
    xmlns:notifications="using:Shyd.Prism.Notifications"
    Width="360"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    ShowActivated="False"
    SystemDecorations="None"
    Topmost="True"
    d:DesignWidth="360"
    mc:Ignorable="d"
    WindowStartupLocation="Manual">

    <!--  自包含样式：不依赖宿主应用的皮肤类，颜色/字号直接内联；
         内容绑定基类规定的 ToastTitle / ToastMessage / ToastHint（逻辑全部在 ToastWindowBase）  -->
    <Border
        Padding="12"
        Background="#FFFFFF"
        BorderBrush="#2F6FD0"
        BorderThickness="1"
        CornerRadius="3">
        <Grid ColumnDefinitions="Auto,*">
            <Border
                Grid.Column="0"
                Width="3"
                Margin="0,2,8,2"
                Background="#2F6FD0" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    Text="{Binding ToastTitle}" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    MaxHeight="80"
                    TextWrapping="Wrap"
                    Text="{Binding ToastMessage}" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.75"
                    IsVisible="{Binding HasHint}"
                    Text="{Binding ToastHint}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
