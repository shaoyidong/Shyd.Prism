<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NuGet 包元数据 -->
    <Version>1.0.4</Version>
    <PackageId>Shyd.Prism.Core</PackageId>
    <Authors>Shyd</Authors>
    <Description>仿 Prism 的精简 AOT 框架基座（无 UI）：MVVM 基类、键值参数、事件聚合器、可热更 JSON 语言包 i18n 机制（内容由宿主注入）。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/shaoyidong/Shyd.Prism</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
